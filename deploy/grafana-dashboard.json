{
 "dashboard": {
  "uid": "nginx-fleet",
  "title": "nginx Fleet \u2014 Operations",
  "tags": [
   "nginx",
   "keepalived",
   "noc"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
   "from": "now-3h",
   "to": "now"
  },
  "templating": {
   "list": [
    {
     "name": "vhost",
     "type": "query",
     "datasource": {
      "type": "prometheus",
      "uid": "bfum9nnilgflsf"
     },
     "refresh": 2,
     "query": {
      "query": "label_values(nginx_fleet_ingress_requests_total, vhost)",
      "refId": "var"
     },
     "includeAll": false,
     "multi": false,
     "current": {}
    }
   ]
  },
  "annotations": {
   "list": [
    {
     "name": "failovers",
     "datasource": {
      "type": "prometheus",
      "uid": "bfum9nnilgflsf"
     },
     "enable": true,
     "iconColor": "red",
     "expr": "sum(increase(nginx_fleet_vrrp_transitions_total[1m])) > 0",
     "titleFormat": "VRRP failover"
    }
   ]
  },
  "panels": [
   {
    "id": 1,
    "title": "VIP HOLDER",
    "type": "stat",
    "datasource": {
     "type": "prometheus",
     "uid": "bfum9nnilgflsf"
    },
    "gridPos": {
     "x": 0,
     "y": 0,
     "w": 6,
     "h": 5
    },
    "targets": [
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bfum9nnilgflsf"
      },
      "expr": "max by (vrid, vip, node) (nginx_fleet_vrrp_master) == 1",
      "legendFormat": "{{vip}} \u2192 {{node}}",
      "instant": true,
      "refId": "A"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "thresholds": {
       "mode": "absolute",
       "steps": [
        {
         "color": "blue",
         "value": null
        }
       ]
      }
     },
     "overrides": []
    },
    "options": {
     "colorMode": "background",
     "textMode": "name",
     "reduceOptions": {
      "calc": "lastNotNull"
     }
    }
   },
   {
    "id": 2,
    "title": "BLACKHOLE",
    "type": "stat",
    "datasource": {
     "type": "prometheus",
     "uid": "bfum9nnilgflsf"
    },
    "gridPos": {
     "x": 6,
     "y": 0,
     "w": 3,
     "h": 5
    },
    "targets": [
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bfum9nnilgflsf"
      },
      "expr": "count(nginx_fleet_active == 1 unless on (instance) nginx_fleet_worker_fds_open) or vector(0)",
      "legendFormat": "master w/o nginx",
      "instant": true,
      "refId": "A"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "thresholds": {
       "mode": "absolute",
       "steps": [
        {
         "color": "green",
         "value": null
        },
        {
         "color": "red",
         "value": 1
        }
       ]
      }
     },
     "overrides": []
    },
    "options": {
     "colorMode": "background",
     "textMode": "value_and_name",
     "reduceOptions": {
      "calc": "lastNotNull"
     }
    }
   },
   {
    "id": 3,
    "title": "SPLIT BRAIN",
    "type": "stat",
    "datasource": {
     "type": "prometheus",
     "uid": "bfum9nnilgflsf"
    },
    "gridPos": {
     "x": 9,
     "y": 0,
     "w": 3,
     "h": 5
    },
    "targets": [
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bfum9nnilgflsf"
      },
      "expr": "count(count by (vrid) (max by (vrid, node) (nginx_fleet_vrrp_master) == 1) > 1) or vector(0)",
      "legendFormat": "vrids w/ 2 masters",
      "instant": true,
      "refId": "A"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "thresholds": {
       "mode": "absolute",
       "steps": [
        {
         "color": "green",
         "value": null
        },
        {
         "color": "red",
         "value": 1
        }
       ]
      }
     },
     "overrides": []
    },
    "options": {
     "colorMode": "background",
     "textMode": "value_and_name",
     "reduceOptions": {
      "calc": "lastNotNull"
     }
    }
   },
   {
    "id": 4,
    "title": "5XX RATE",
    "type": "stat",
    "datasource": {
     "type": "prometheus",
     "uid": "bfum9nnilgflsf"
    },
    "gridPos": {
     "x": 12,
     "y": 0,
     "w": 3,
     "h": 5
    },
    "targets": [
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bfum9nnilgflsf"
      },
      "expr": "100 * (sum(rate(nginx_fleet_ingress_requests_total{status_class=\"5xx\"}[5m])) or vector(0)) / sum(rate(nginx_fleet_ingress_requests_total[5m]))",
      "legendFormat": "of all requests",
      "instant": true,
      "refId": "A"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "thresholds": {
       "mode": "absolute",
       "steps": [
        {
         "color": "green",
         "value": null
        },
        {
         "color": "red",
         "value": 5
        }
       ]
      },
      "unit": "percent",
      "decimals": 1
     },
     "overrides": []
    },
    "options": {
     "colorMode": "background",
     "textMode": "value_and_name",
     "reduceOptions": {
      "calc": "lastNotNull"
     }
    }
   },
   {
    "id": 5,
    "title": "UPSTREAMS DOWN",
    "type": "stat",
    "datasource": {
     "type": "prometheus",
     "uid": "bfum9nnilgflsf"
    },
    "gridPos": {
     "x": 15,
     "y": 0,
     "w": 3,
     "h": 5
    },
    "targets": [
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bfum9nnilgflsf"
      },
      "expr": "count(max by (vhost, upstream_addr) (nginx_fleet_upstream_up) == 0) or vector(0)",
      "legendFormat": "members",
      "instant": true,
      "refId": "A"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "thresholds": {
       "mode": "absolute",
       "steps": [
        {
         "color": "green",
         "value": null
        },
        {
         "color": "red",
         "value": 1
        }
       ]
      }
     },
     "overrides": []
    },
    "options": {
     "colorMode": "background",
     "textMode": "value_and_name",
     "reduceOptions": {
      "calc": "lastNotNull"
     }
    }
   },
   {
    "id": 6,
    "title": "IDLE > 5 DAYS",
    "type": "stat",
    "datasource": {
     "type": "prometheus",
     "uid": "bfum9nnilgflsf"
    },
    "gridPos": {
     "x": 18,
     "y": 0,
     "w": 3,
     "h": 5
    },
    "targets": [
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bfum9nnilgflsf"
      },
      "expr": "count((time() - max by (vhost, upstream_addr) (nginx_fleet_upstream_last_traffic_timestamp_seconds)) > 432000) or vector(0)",
      "legendFormat": "decommission",
      "instant": true,
      "refId": "A"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "thresholds": {
       "mode": "absolute",
       "steps": [
        {
         "color": "green",
         "value": null
        },
        {
         "color": "red",
         "value": 1
        }
       ]
      }
     },
     "overrides": []
    },
    "options": {
     "colorMode": "background",
     "textMode": "value_and_name",
     "reduceOptions": {
      "calc": "lastNotNull"
     }
    }
   },
   {
    "id": 7,
    "title": "EXPORTERS DOWN",
    "type": "stat",
    "datasource": {
     "type": "prometheus",
     "uid": "bfum9nnilgflsf"
    },
    "gridPos": {
     "x": 21,
     "y": 0,
     "w": 3,
     "h": 5
    },
    "targets": [
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bfum9nnilgflsf"
      },
      "expr": "count(up{job=\"nginx-fleet\"} == 0) or vector(0)",
      "legendFormat": "of fleet",
      "instant": true,
      "refId": "A"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "thresholds": {
       "mode": "absolute",
       "steps": [
        {
         "color": "green",
         "value": null
        },
        {
         "color": "red",
         "value": 1
        }
       ]
      }
     },
     "overrides": []
    },
    "options": {
     "colorMode": "background",
     "textMode": "value_and_name",
     "reduceOptions": {
      "calc": "lastNotNull"
     }
    }
   },
   {
    "id": 8,
    "title": "$vhost \u2014 live topology: VIP \u2192 vhost \u2192 upstream (req/s)",
    "type": "nodeGraph",
    "datasource": {
     "type": "prometheus",
     "uid": "bfum9nnilgflsf"
    },
    "gridPos": {
     "x": 0,
     "y": 5,
     "w": 14,
     "h": 11
    },
    "targets": [
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bfum9nnilgflsf"
      },
      "expr": "label_replace(label_replace(sum by (vhost) (rate(nginx_fleet_ingress_requests_total{vhost=\"$vhost\"}[5m])), \"source\", \"VIP 192.168.2.154\", \"\", \"\"), \"target\", \"$1\", \"vhost\", \"(.*)\")",
      "legendFormat": "",
      "instant": true,
      "format": "table",
      "refId": "A"
     },
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bfum9nnilgflsf"
      },
      "expr": "label_replace(label_replace(sum by (vhost, upstream_addr) (rate(nginx_fleet_upstream_requests_total{vhost=\"$vhost\"}[5m])), \"source\", \"$1\", \"vhost\", \"(.*)\"), \"target\", \"$1\", \"upstream_addr\", \"(.*)\")",
      "legendFormat": "",
      "instant": true,
      "format": "table",
      "refId": "B"
     }
    ],
    "fieldConfig": {
     "defaults": {},
     "overrides": []
    },
    "transformations": [
     {
      "id": "merge",
      "options": {}
     },
     {
      "id": "organize",
      "options": {
       "excludeByName": {
        "Time": true,
        "vhost": true,
        "upstream_addr": true
       },
       "renameByName": {
        "Value": "mainstat"
       }
      }
     },
     {
      "id": "calculateField",
      "options": {
       "mode": "index",
       "alias": "id"
      }
     }
    ],
    "options": {
     "nodes": {},
     "edges": {
      "mainStatUnit": "reqps"
     }
    }
   },
   {
    "id": 9,
    "title": "$vhost \u2014 flow detail",
    "type": "table",
    "datasource": {
     "type": "prometheus",
     "uid": "bfum9nnilgflsf"
    },
    "gridPos": {
     "x": 14,
     "y": 5,
     "w": 10,
     "h": 11
    },
    "targets": [
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bfum9nnilgflsf"
      },
      "expr": "sum by (vhost, upstream_addr) (rate(nginx_fleet_upstream_requests_total{vhost=\"$vhost\"}[5m]))",
      "legendFormat": "",
      "instant": true,
      "format": "table",
      "refId": "A"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "decimals": 2
     },
     "overrides": []
    },
    "transformations": [
     {
      "id": "organize",
      "options": {
       "excludeByName": {
        "Time": true
       },
       "renameByName": {
        "Value": "req/s"
       }
      }
     },
     {
      "id": "sortBy",
      "options": {
       "sort": [
        {
         "field": "req/s",
         "desc": true
        }
       ]
      }
     }
    ]
   },
   {
    "id": 10,
    "title": "$vhost \u2014 requests by status",
    "type": "timeseries",
    "datasource": {
     "type": "prometheus",
     "uid": "bfum9nnilgflsf"
    },
    "gridPos": {
     "x": 0,
     "y": 16,
     "w": 8,
     "h": 8
    },
    "targets": [
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bfum9nnilgflsf"
      },
      "expr": "sum by (status_class) (rate(nginx_fleet_ingress_requests_total{vhost=\"$vhost\"}[5m]))",
      "legendFormat": "{{status_class}}",
      "refId": "A"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "unit": "reqps",
      "custom": {
       "fillOpacity": 15,
       "stacking": {
        "mode": "normal"
       }
      }
     },
     "overrides": []
    },
    "repeat": "vhost",
    "repeatDirection": "h",
    "maxPerRow": 3
   },
   {
    "id": 11,
    "title": "$vhost \u2014 upstream members",
    "type": "table",
    "datasource": {
     "type": "prometheus",
     "uid": "bfum9nnilgflsf"
    },
    "gridPos": {
     "x": 0,
     "y": 24,
     "w": 12,
     "h": 8
    },
    "targets": [
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bfum9nnilgflsf"
      },
      "expr": "max by (upstream_addr) (nginx_fleet_upstream_up{vhost=\"$vhost\"})",
      "legendFormat": "",
      "instant": true,
      "format": "table",
      "refId": "A"
     },
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bfum9nnilgflsf"
      },
      "expr": "sum by (upstream_addr) (rate(nginx_fleet_upstream_requests_total{vhost=\"$vhost\"}[5m]))",
      "legendFormat": "",
      "instant": true,
      "format": "table",
      "refId": "B"
     },
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bfum9nnilgflsf"
      },
      "expr": "(time() - max by (upstream_addr) (nginx_fleet_upstream_last_traffic_timestamp_seconds{vhost=\"$vhost\"})) / 3600",
      "legendFormat": "",
      "instant": true,
      "format": "table",
      "refId": "C"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "decimals": 2
     },
     "overrides": [
      {
       "matcher": {
        "id": "byName",
        "options": "up"
       },
       "properties": [
        {
         "id": "mappings",
         "value": [
          {
           "type": "value",
           "options": {
            "1": {
             "text": "UP",
             "color": "green"
            },
            "0": {
             "text": "DOWN",
             "color": "red"
            }
           }
          }
         ]
        },
        {
         "id": "custom.cellOptions",
         "value": {
          "type": "color-background"
         }
        }
       ]
      },
      {
       "matcher": {
        "id": "byName",
        "options": "idle (h)"
       },
       "properties": [
        {
         "id": "thresholds",
         "value": {
          "mode": "absolute",
          "steps": [
           {
            "color": "green",
            "value": null
           },
           {
            "color": "orange",
            "value": 72
           },
           {
            "color": "red",
            "value": 120
           }
          ]
         }
        },
        {
         "id": "custom.cellOptions",
         "value": {
          "type": "color-background"
         }
        }
       ]
      }
     ]
    },
    "transformations": [
     {
      "id": "joinByField",
      "options": {
       "byField": "upstream_addr",
       "mode": "outer"
      }
     },
     {
      "id": "organize",
      "options": {
       "excludeByName": {
        "Time 1": true,
        "Time 2": true,
        "Time 3": true
       },
       "renameByName": {
        "Value #A": "up",
        "Value #B": "req/s",
        "Value #C": "idle (h)"
       }
      }
     }
    ]
   },
   {
    "id": 12,
    "title": "$vhost \u2014 upstream latency & failures",
    "type": "timeseries",
    "datasource": {
     "type": "prometheus",
     "uid": "bfum9nnilgflsf"
    },
    "gridPos": {
     "x": 12,
     "y": 24,
     "w": 12,
     "h": 8
    },
    "targets": [
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bfum9nnilgflsf"
      },
      "expr": "sum by (upstream_addr) (rate(nginx_fleet_upstream_response_seconds_sum{vhost=\"$vhost\"}[5m])) / sum by (upstream_addr) (rate(nginx_fleet_upstream_requests_total{vhost=\"$vhost\"}[5m]))",
      "legendFormat": "{{upstream_addr}} latency",
      "refId": "A"
     },
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bfum9nnilgflsf"
      },
      "expr": "sum by (upstream_addr, reason) (rate(nginx_fleet_upstream_failures_total{vhost=\"$vhost\"}[5m]))",
      "legendFormat": "{{upstream_addr}} {{reason}}",
      "refId": "B"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "unit": "s"
     },
     "overrides": []
    }
   },
   {
    "id": 13,
    "title": "$vhost \u2014 configured listeners & backends",
    "type": "table",
    "datasource": {
     "type": "prometheus",
     "uid": "bfum9nnilgflsf"
    },
    "gridPos": {
     "x": 0,
     "y": 32,
     "w": 24,
     "h": 6
    },
    "targets": [
     {
      "datasource": {
       "type": "prometheus",
       "uid": "bfum9nnilgflsf"
      },
      "expr": "max by (listen_port, tls, upstream_addr, config_file) (nginx_fleet_vhost_info{vhost=\"$vhost\"})",
      "legendFormat": "",
      "instant": true,
      "format": "table",
      "refId": "A"
     }
    ],
    "fieldConfig": {
     "defaults": {},
     "overrides": []
    },
    "transformations": [
     {
      "id": "organize",
      "options": {
       "excludeByName": {
        "Time": true,
        "Value": true
       }
      }
     }
    ]
   }
  ]
 },
 "overwrite": true,
 "message": "topology scoped to selected vhost"
}